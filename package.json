{
    "name": "pickle-select",
    "version": "1.1.0",
    "description": "A modular, accessible vanilla JS <select> replacement utility with a funny name.",
    "keywords": [
        "select",
        "dropdown", 
        "vanilla-js",
        "accessibility",
        "ui",
        "component",
        "form",
        "input",
        "aria",
        "keyboard-navigation"
    ],
    "repository": {
        "type": "git",
        "url": "git+https://github.com/gh-o-st/pickle.git"
    },
    "bugs": {
        "url": "https://github.com/gh-o-st/pickle/issues"
    },
    "homepage": "https://picklejs.dev",
    "documentation": "https://picklejs.dev/docs",
    "license": "MPL-2.0",
    "author": {
        "name": "gh-o-st",
        "url": "https://github.com/gh-o-st"
    },
    "main": "./dist/pickle.umd.min.js",
    "module": "./dist/pickle.esm.min.js",
    "exports": {
        ".": {
            "import": "./dist/pickle.esm.min.js",
            "require": "./dist/pickle.umd.min.js"
        },
        "./pickle.css": "./dist/pickle.min.css"
    },
    "files": [
        "dist"
    ],
    "scripts": {
        "test": "jest --config jest.config.mjs --coverage",
        "test:watch": "jest --config jest.config.mjs --watch"
    },
    "style": "./dist/pickle.min.css",
    "devDependencies": {
        "@babel/core": "^7.28.3",
        "@babel/preset-env": "^7.28.3",
        "@testing-library/jest-dom": "^6.8.0",
        "babel-jest": "^30.0.5",
        "identity-obj-proxy": "^3.0.0",
        "jest": "^30.0.5",
        "jest-environment-jsdom": "^30.0.5"
    }
}